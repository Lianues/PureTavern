{
  "name": "pure-tavern",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm --filter @pure-tavern/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:browser": "pnpm --filter @pure-tavern/web test:browser",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version:set": "node scripts/set-release-version.mjs",
    "legacy:prepare": "node apps/web/scripts/prepare-legacy-runtime.mjs",
    "legacy:sync": "node apps/web/scripts/sync-legacy.mjs",
    "legacy:sync:check": "node apps/web/scripts/sync-legacy.mjs --check",
    "legacy:contracts:generate": "node apps/web/scripts/legacy-contracts.mjs generate",
    "legacy:contracts:check": "node apps/web/scripts/legacy-contracts.mjs check",
    "legacy:verify": "pnpm --filter @pure-tavern/web legacy:verify",
    "android:sync": "pnpm build && pnpm --filter @pure-tavern/mobile sync:android",
    "android:open": "pnpm build && pnpm --filter @pure-tavern/mobile open:android",
    "android:debug": "pnpm build && pnpm --filter @pure-tavern/mobile build:android:debug",
    "android:release": "pnpm build && pnpm --filter @pure-tavern/mobile build:android:release",
    "ios:sync": "pnpm build && pnpm --filter @pure-tavern/mobile sync:ios",
    "ios:open": "pnpm build && pnpm --filter @pure-tavern/mobile open:ios",
    "harmony:sync": "pnpm build && pnpm --dir apps/harmony sync:web",
    "harmony:build": "pnpm build && pnpm --dir apps/harmony build:hap",
    "harmony:deploy": "pnpm --dir apps/harmony deploy:local",
    "desktop:dev": "pnpm --filter @pure-tavern/desktop dev:desktop",
    "desktop:build": "pnpm --filter @pure-tavern/desktop build:desktop",
    "vscode:build": "pnpm build && pnpm --dir apps/vscode-extension build:extension",
    "vscode:package": "pnpm build && pnpm --dir apps/vscode-extension build:extension && pnpm --dir apps/vscode-extension package:vsix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
