    "js-sha256": "^0.11.1",
    "localforage": "^1.10.0",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "morphdom": "^2.7.7",
    "seedrandom": "^3.0.5",
    "showdown": "^2.1.0",
    "slidetoggle": "^4.0.0",
    "tokenx": "^1.3.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.27.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "mime": "1.6.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  }
