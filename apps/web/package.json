{
  "name": "@pure-tavern/web",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-legacy-runtime.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare-legacy-runtime.mjs",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:browser": "node scripts/prepare-legacy-runtime.mjs",
    "test:browser": "node scripts/verify-browser-startup.mjs",
    "legacy:prepare": "node scripts/prepare-legacy-runtime.mjs",
    "legacy:sync": "node scripts/sync-legacy.mjs",
    "legacy:sync:check": "node scripts/sync-legacy.mjs --check",
    "legacy:contracts:generate": "node scripts/legacy-contracts.mjs generate",
    "legacy:contracts:check": "node scripts/legacy-contracts.mjs check",
    "legacy:verify": "node scripts/verify-legacy.mjs"
  },
  "dependencies": {
    "@adobe/css-tools": "^4.4.4",
    "@iconfu/svg-inject": "^1.2.3",
    "@mozilla/readability": "^0.6.0",
    "@popperjs/core": "^2.11.8",
    "@pure-tavern/contracts": "workspace:*",
    "@pure-tavern/shared": "workspace:*",
    "bowser": "^2.12.1",
    "chalk": "^5.6.0",
    "chevrotain": "^11.2.0",
    "dexie": "^4.4.4",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.2",
    "droll": "^0.2.1",
    "fflate": "^0.8.2",
    "fuse.js": "^7.1.0",
    "handlebars": "^4.7.9",
